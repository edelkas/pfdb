# Normalize line endings: LF in the repo, native on checkout for scripts
* text=auto

# Source files always LF
*.cpp   text eol=lf
*.hpp   text eol=lf
*.h     text eol=lf
*.cmake text eol=lf
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
CMakeLists.txt text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf

# Test fixtures are byte-exact captures of real pages: never touch them
tests/fixtures/** -text
